    ],
    "action": [
        "switch ($_IPS['VALUE']) {",
        "    case 'Play':",
        "        OAVR_Play($_IPS['TARGET']);",
        "        break;",
        "    case 'Pause':",
        "        OAVR_Pause($_IPS['TARGET']);",
        "        break;",
        "    case 'Stop':",
        "        OAVR_Stop($_IPS['TARGET']);",
        "        break;",
        "    case 'NextTrack':",
        "        OAVR_NextTrack($_IPS['TARGET']);",
        "        break;",
        "    case 'PreviousTrack':",
        "        OAVR_PreviousTrack($_IPS['TARGET']);",
        "        break;",
        "    case 'Shuffle':",
        "        OAVR_Shuffle($_IPS['TARGET']);",
        "        break;",
        "    case 'Repeat':",
        "        OAVR_Repeat($_IPS['TARGET']);",
        "        break;",
        "    case 'Menu':",
        "        OAVR_Menu($_IPS['TARGET']);",
        "        break;",
        "}"
    ],
    "category": "target",
