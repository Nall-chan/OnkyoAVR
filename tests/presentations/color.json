        "  $_IPS['ENCODING'] = 0;",
        "}",
        "switch ($_IPS['ENCODING']) {",
        "  case 0:",
        "    return json_encode(['r' => 0, 'g' => 205, 'b' => 171]);",
        "  case 1:",
        "    return json_encode(['c' => 100, 'm' => 0, 'y' => 17, 'k' => 20]);",
        "  case 2:",
        "    return json_encode(['h' => 170, 's' => 1.0, 'v' => 0.804]);",
        "  case 3:",
        "    return json_encode(['h' => 170, 's' => 1.0, 'l' => 0.402]);",
        "  case 4:",
        "    return json_encode(['x' => 0.64, 'y' => 0.33]);",
        "}"
