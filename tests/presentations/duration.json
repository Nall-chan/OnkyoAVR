    "presentationValue": [
        "if (!isset($_IPS['COUNTDOWN_TYPE'])) {",
        "  $_IPS['COUNTDOWN_TYPE'] = 0;",
        "}",
        "switch ($_IPS['COUNTDOWN_TYPE']) {",
        "  case 0:",
        "    return 7322;",
        "  case 1:",
        "    return time() + 7322;",
        "  case 2:",
        "    return time() - 7322;",
        "}"
