    "presentationValue": [
        "$value = (42 * ($_IPS['MAX'] - $_IPS['MIN']) / 100) + $_IPS['MIN'];",
        "if ($_IPS['STEP_SIZE'] === 0) {",
        "  return $value;",
        "}",
        "else {",
        "  return $value - fmod($value - $_IPS['MIN'], $_IPS['STEP_SIZE']);",
        "}"
